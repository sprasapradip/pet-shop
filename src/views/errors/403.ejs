<section class="section">
  <div class="container-x max-w-xl text-center">
    <span class="inline-flex size-16 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 ring-1 ring-brand-100"><%- icon('lock', 'size-8') %></span>
    <h1 class="text-3xl font-extrabold mt-4">Access denied</h1>
    <p class="text-stone-600 mt-3"><%= typeof message !== 'undefined' ? message : 'You do not have access to this page.' %></p>
    <a href="/" class="btn-primary mt-6">Go home</a>
  </div>
</section>
