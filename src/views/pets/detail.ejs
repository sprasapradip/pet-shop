<% const cover = listing.images[0]; const waMsg = 'Hello, I am interested in ' + listing.title + ' (code ' + listing.code + '). Is it still available?'; %>
<section class="container-x py-8">
  <%- include('../partials/breadcrumbs', { seo: { breadcrumbs: [{ name: 'Home', url: '/' }, { name: 'Pets for sale', url: '/pets' }, { name: listing.title, url: '/pets/' + listing.slug }] } }) %>
  <div class="grid lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12">
    <div data-gallery>
      <div class="card overflow-hidden aspect-[4/3] bg-stone-100 relative">
        <img data-gallery-main src="<%= imgSrc(cover && cover.path, 1200) %>" <% if (cover) { %>srcset="<%= imgSrcset(cover.path) %>" sizes="(max-width: 1024px) 100vw, 640px"<% } %> alt="<%= cover ? cover.alt : listing.title %>" width="1200" height="900" class="w-full h-full object-cover" fetchpriority="high">
        <% if (listing.status !== 'AVAILABLE') { %><span class="badge absolute top-4 left-4 text-sm status-<%= listing.status %>"><%= listing.status === 'RESERVED' ? 'Reserved' : 'Sold' %></span><% } %>
      </div>
      <% if (listing.images.length > 1) { %>
        <div class="mt-3 grid grid-cols-5 gap-2">
          <% listing.images.forEach(function (im, i) { %>
            <button type="button" class="card overflow-hidden aspect-square aria-[current=true]:ring-2 aria-[current=true]:ring-brand-600" data-gallery-thumb data-full="<%= imgSrc(im.path, 1200) %>" data-srcset="<%= imgSrcset(im.path) %>" data-alt="<%= im.alt %>" aria-current="<%= i === 0 %>" aria-label="Show photo <%= i + 1 %>">
              <img src="<%= imgSrc(im.path, 400) %>" alt="" width="100" height="100" loading="lazy" class="w-full h-full object-cover">
            </button>
          <% }) %>
        </div>
      <% } %>
      <% if (videoEmbed) { %>
        <div class="card overflow-hidden aspect-video mt-4">
          <iframe src="<%= videoEmbed %>" title="Video of <%= listing.title %>" loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen class="w-full h-full border-0"></iframe>
        </div>
      <% } else if (listing.videoUrl) { %>
        <a href="<%= listing.videoUrl %>" class="btn-outline mt-4" target="_blank" rel="noopener">▶ Watch video</a>
      <% } %>
    </div>

    <div>
      <p class="text-sm text-stone-500">Code <strong><%= listing.code %></strong> · <%= listing.origin === 'IMPORTED' ? 'Imported' : 'Locally bred' %></p>
      <h1 class="text-2xl sm:text-3xl font-extrabold mt-1"><%= listing.title %></h1>
      <p class="text-3xl font-extrabold text-brand-800 mt-4"><%= formatNpr(listing.pricePaisa) %></p>

      <dl class="mt-6 grid grid-cols-2 gap-3 text-sm">
        <% [['Breed', listing.breed.name], ['Gender', listing.gender === 'MALE' ? 'Male' : 'Female'], ['Age', ageFrom(listing.dateOfBirth)], ['Date of birth', formatDay(listing.dateOfBirth)], ['Color', listing.color || '—'], ['Origin', listing.origin === 'IMPORTED' ? 'Imported' : 'Local']].forEach(function (r) { %>
          <div class="card p-3"><dt class="text-stone-500 text-xs"><%= r[0] %></dt><dd class="font-semibold"><%= r[1] %></dd></div>
        <% }) %>
      </dl>

      <h2 class="font-bold mt-6">Health and papers</h2>
      <ul class="mt-2 grid sm:grid-cols-2 gap-2 text-sm">
        <li class="flex gap-2"><span aria-hidden="true"><%= listing.vaccinated ? '✅' : '⬜' %></span> Vaccinated<%= listing.vaccinated ? '' : ' (not yet)' %></li>
        <li class="flex gap-2"><span aria-hidden="true"><%= listing.dewormed ? '✅' : '⬜' %></span> Dewormed<%= listing.dewormed ? '' : ' (not yet)' %></li>
        <li class="flex gap-2"><span aria-hidden="true"><%= listing.microchipNo ? '✅' : '⬜' %></span> Microchip<%= listing.microchipNo ? ': ' + listing.microchipNo : ' (none)' %></li>
        <li class="flex gap-2"><span aria-hidden="true"><%= listing.registrationNo ? '✅' : '⬜' %></span> KCI / registration<%= listing.registrationNo ? ': ' + listing.registrationNo : ' (none)' %></li>
        <% if (listing.origin === 'IMPORTED') { %><li class="flex gap-2 sm:col-span-2"><span aria-hidden="true"><%= listing.healthCertificate ? '✅' : '⬜' %></span> Import permit and health certificate <%= listing.healthCertificate ? 'available to view' : 'pending' %></li><% } %>
      </ul>

      <% if (listing.status === 'AVAILABLE') { %>
        <div class="mt-6 space-y-3">
          <a href="<%= whatsappLink(waMsg) %>" class="btn-wa w-full" target="_blank" rel="noopener">💬 Ask on WhatsApp (<%= listing.code %>)</a>
          <% if (listing.depositPaisa > 0 && (settings.payments.esewaEnabled || settings.payments.khaltiEnabled)) { %>
            <div class="card p-4">
              <p class="font-semibold">Reserve with a <%= formatNpr(listing.depositPaisa) %> deposit</p>
              <p class="text-sm text-stone-600">Holds this pet for you for 72 hours. Balance paid at handover.</p>
              <% if (user) { %>
                <form action="/pets/<%= listing.slug %>/reserve" method="post" class="mt-3 flex flex-col sm:flex-row gap-2">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <% if (settings.payments.esewaEnabled) { %><button name="gateway" value="ESEWA" class="btn-primary flex-1">Pay with eSewa</button><% } %>
                  <% if (settings.payments.khaltiEnabled) { %><button name="gateway" value="KHALTI" class="btn-outline flex-1">Pay with Khalti</button><% } %>
                </form>
              <% } else { %>
                <a href="/login?next=/pets/<%= listing.slug %>" class="btn-primary w-full mt-3">Log in to reserve</a>
              <% } %>
            </div>
          <% } %>
          <details class="card p-4" <%= fieldError('name') || fieldError('phone') ? 'open' : '' %>>
            <summary class="font-semibold cursor-pointer">📅 Schedule a visit</summary>
            <form action="/pets/<%= listing.slug %>/visit" method="post" class="mt-4">
              <%- include('../partials/form-guard') %>
              <div class="grid sm:grid-cols-2 gap-x-3">
                <%- include('../partials/field', { name: 'name', label: 'Your name', required: true, value: oldValue('name', user ? user.name : '') }) %>
                <%- include('../partials/field', { name: 'phone', label: 'Phone', type: 'tel', required: true }) %>
              </div>
              <%- include('../partials/field', { name: 'visitDate', label: 'Preferred date', type: 'date' }) %>
              <%- include('../partials/field', { name: 'message', label: 'Message (optional)', type: 'textarea', rows: 2 }) %>
              <button class="btn-outline w-full">Request a visit</button>
            </form>
          </details>
        </div>
      <% } else if (listing.status === 'RESERVED') { %>
        <div class="alert alert-info mt-6">This pet is reserved. <a class="link" href="<%= whatsappLink('Hello, please tell me if ' + listing.code + ' becomes available again, or about similar pets.') %>" target="_blank" rel="noopener">Ask us about similar pets</a>.</div>
      <% } else { %>
        <div class="alert alert-info mt-6">This pet has found a new home. <a class="link" href="/pets?species=<%= listing.species %>">See available pets</a>.</div>
      <% } %>
    </div>
  </div>

  <div class="mt-12 grid lg:grid-cols-2 gap-8">
    <% if (listing.description) { %><div><h2 class="text-xl font-bold">About <%= listing.title %></h2><div class="prose-ek whitespace-pre-line mt-3"><%= listing.description %></div></div><% } %>
    <% if (listing.parentsInfo) { %><div><h2 class="text-xl font-bold">Parents</h2><div class="prose-ek whitespace-pre-line mt-3"><%= listing.parentsInfo %></div></div><% } %>
  </div>
  <p class="text-sm text-stone-500 mt-8">Please read our <a class="link" href="/animal-sale-policy">animal sale and health guarantee policy</a> before buying.</p>
</section>
