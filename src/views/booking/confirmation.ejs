<% const isBoarding = booking.service.type === 'BOARDING'; %>
<section class="container-x py-12 max-w-2xl">
  <div class="card p-8 text-center">
    <p class="text-5xl" aria-hidden="true"><%= booking.status === 'CANCELLED' ? '❌' : '✅' %></p>
    <h1 class="text-2xl sm:text-3xl font-extrabold mt-3"><%= booking.status === 'CANCELLED' ? 'Booking cancelled' : 'Booking received' %></h1>
    <p class="text-stone-600 mt-2">Reference <strong class="text-stone-900"><%= booking.reference %></strong></p>
    <p class="mt-3"><span class="status status-<%= booking.status %>"><%= bookingStatusLabel(booking.status) %></span></p>
    <% if (booking.status === 'PENDING' && dueAdvance === 0) { %><p class="text-sm text-stone-600 mt-3">We will call <%= booking.contactPhone %> to confirm.</p><% } %>
  </div>

  <% if (dueAdvance > 0 && ['PENDING','CONFIRMED'].includes(booking.status)) { %>
    <div class="card p-6 mt-6 border-amber-300 bg-amber-50">
      <h2 class="font-bold text-lg">Pay the advance: <%= formatNpr(dueAdvance) %></h2>
      <p class="text-sm text-stone-700 mt-1">This service needs an advance to hold your <%= isBoarding ? 'kennel' : 'slot' %>. Unpaid bookings are released after 30 minutes.</p>
      <form action="/book/<%= booking.reference %>/pay" method="post" class="mt-4 flex flex-col sm:flex-row gap-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (settings.payments.esewaEnabled) { %><button name="gateway" value="ESEWA" class="btn-primary flex-1">Pay with eSewa</button><% } %>
        <% if (settings.payments.khaltiEnabled) { %><button name="gateway" value="KHALTI" class="btn-outline flex-1">Pay with Khalti</button><% } %>
      </form>
    </div>
  <% } %>

  <div class="card p-6 mt-6">
    <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-stone-500">Service</dt><dd class="font-medium"><%= booking.service.name %></dd>
      <% if (isBoarding) { %>
        <dt class="text-stone-500">Check in</dt><dd><%= formatDateTime(booking.startAt) %></dd>
        <dt class="text-stone-500">Check out</dt><dd><%= formatDateTime(booking.endAt) %></dd>
        <% if (booking.kennelUnit) { %><dt class="text-stone-500">Kennel</dt><dd><%= booking.kennelUnit.code %> (<%= booking.kennelUnit.size.toLowerCase() %>)</dd><% } %>
      <% } else { %>
        <dt class="text-stone-500">When</dt><dd><%= formatDateTime(booking.startAt) %></dd>
      <% } %>
      <dt class="text-stone-500">Pet</dt><dd><%= booking.pet ? booking.pet.name : booking.petSummary %></dd>
      <% if (booking.addressText) { %><dt class="text-stone-500">Address</dt><dd><%= booking.addressText %></dd><% } %>
      <dt class="text-stone-500">Contact</dt><dd><%= booking.contactName %>, <%= booking.contactPhone %></dd>
      <% if (booking.pricePaisa) { %><dt class="text-stone-500">Price</dt><dd><%= isBoarding ? '' : 'From ' %><%= formatNpr(booking.pricePaisa) %></dd><% } %>
      <% if (booking.paidPaisa) { %><dt class="text-stone-500">Paid</dt><dd><%= formatNpr(booking.paidPaisa) %></dd><% } %>
    </dl>
  </div>

  <div class="mt-6 flex flex-wrap gap-3 justify-center">
    <% if (user) { %><a href="/account/bookings" class="btn-primary">My bookings</a><% } %>
    <a href="<%= whatsappLink('Hello, about my booking ' + booking.reference) %>" class="btn-wa" target="_blank" rel="noopener">WhatsApp us</a>
    <a href="/" class="btn-outline">Home</a>
  </div>
</section>
