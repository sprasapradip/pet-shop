<%
  const cardIcon = { HOUSE_CALL: 'house', VACCINATION: 'syringe', TREATMENT: 'stethoscope', BOARDING: 'warehouse', TRAINING: 'graduation-cap', MATING: 'heart', PUPPY_TRADE: 'paw-print', SHELTER: 'hand-heart' };
  const rating = settings.business.googleReviewCount > 0;
%>
<!-- Hero -->
<section class="hero-bg text-white relative overflow-hidden">
  <div class="container-x relative py-14 sm:py-20 lg:py-24 grid lg:grid-cols-[1.15fr_1fr] gap-12 items-center">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-white/10 ring-1 ring-inset ring-white/15 px-3.5 py-1.5 text-sm text-brand-100">
        <%- icon('map-pin', 'size-4 text-brand-300') %> Soaltee Mode, Kathmandu
      </p>
      <h1 class="mt-6 text-[2.15rem] leading-[1.1] sm:text-5xl lg:text-[3.4rem] font-extrabold text-white tracking-tight"><%= settings.home.heroTitle %></h1>
      <p class="mt-5 text-lg text-brand-100/90 max-w-xl leading-relaxed"><%= settings.home.heroSubtitle %></p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/book" class="btn-accent h-12 px-6 text-base"><%- icon('calendar-days', 'size-5') %> Book a service</a>
        <a href="<%= telLink() %>" class="btn-glass h-12 px-6 text-base"><%- icon('phone', 'size-5') %> <%= business.landlineDisplay %></a>
        <a href="<%= whatsappLink('Hello The Everest Kennel, I would like to know more.') %>" class="btn-glass h-12 px-6 text-base" target="_blank" rel="noopener"><%- icon('whatsapp', 'size-5') %> WhatsApp</a>
      </div>
      <dl class="mt-10 grid grid-cols-2 sm:grid-cols-3 gap-4 max-w-lg border-t border-white/10 pt-6">
        <div><dt class="text-xs text-brand-200/80">Vet house calls</dt><dd class="mt-1 font-bold text-white flex items-center gap-1.5"><%- icon('map', 'size-4 text-brand-300') %> Whole valley</dd></div>
        <div><dt class="text-xs text-brand-200/80">Payment</dt><dd class="mt-1 font-bold text-white flex items-center gap-1.5"><%- icon('wallet', 'size-4 text-brand-300') %> COD · eSewa</dd></div>
        <div>
          <dt class="text-xs text-brand-200/80"><%= rating ? 'Google rating' : 'Puppies' %></dt>
          <dd class="mt-1 font-bold text-white flex items-center gap-1.5">
            <% if (rating) { %><%- icon('star', 'size-4 text-accent-400 fill-accent-400') %> <%= settings.business.googleRating.toFixed(1) %> / 5<% } else { %><%- icon('badge-check', 'size-4 text-brand-300') %> Health checked<% } %>
          </dd>
        </div>
      </dl>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:gap-4">
      <% [['/pets','paw-print','Puppies for sale','Local & imported, with records'],['/shop/category/dog-food','package','Dog & cat food','Delivered to your door'],['/services/house-call-vet','stethoscope','Vet house call','Kathmandu, Lalitpur, Bhaktapur'],['/services/dog-boarding-kathmandu','warehouse','Dog boarding','Clean kennels, daily care log']].forEach(function (t, i) { %>
        <a href="<%= t[0] %>" class="group rounded-2xl bg-white/[0.07] hover:bg-white/[0.12] ring-1 ring-inset ring-white/10 backdrop-blur p-5 transition duration-200 <%= i % 2 ? 'sm:translate-y-6' : '' %>">
          <span class="inline-flex size-11 items-center justify-center rounded-xl bg-white text-brand-800 shadow-soft"><%- icon(t[1], 'size-5') %></span>
          <span class="block mt-4 font-bold text-white"><%= t[2] %></span>
          <span class="block text-sm text-brand-100/80 mt-0.5"><%= t[3] %></span>
          <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand-300 group-hover:text-white transition">Explore <%- icon('arrow-right', 'size-4 transition group-hover:translate-x-0.5') %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Services -->
<section class="section">
  <div class="container-x">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <p class="eyebrow"><%- icon('sparkles', 'size-4') %> What we do</p>
        <h2 class="section-title mt-2">Everything your pet needs, in one place</h2>
        <p class="section-lead">One trusted team for food, health, training and care, from puppyhood to old age.</p>
      </div>
      <a href="/services" class="btn-outline shrink-0">All services <%- icon('arrow-right', 'size-4') %></a>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% serviceCards.forEach(function (c) { %>
        <a href="<%= c.href %>" class="card card-hover p-6 group flex flex-col">
          <span class="icon-tile group-hover:bg-brand-700 group-hover:text-white group-hover:ring-brand-700 transition duration-200"><%- icon(cardIcon[c.code], 'size-6') %></span>
          <h3 class="font-bold text-lg mt-5"><%= c.title %></h3>
          <p class="text-sm text-ink-muted mt-1.5 flex-1"><%= c.text %></p>
          <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">Learn more <%- icon('chevron-right', 'size-4 transition group-hover:translate-x-0.5') %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- How booking works -->
<section class="pb-4">
  <div class="container-x">
    <div class="card p-6 sm:p-8 grid gap-6 md:grid-cols-[1fr_2.2fr] items-center bg-gradient-to-br from-white to-brand-50/60">
      <div>
        <p class="eyebrow"><%- icon('calendar-check', 'size-4') %> Easy booking</p>
        <h2 class="text-2xl font-extrabold mt-2">Book in under a minute</h2>
        <a href="/book" class="btn-primary mt-5"><%- icon('calendar-days', 'size-5') %> Start booking</a>
      </div>
      <ol class="grid sm:grid-cols-3 gap-4">
        <% [['clipboard-list','Choose a service','Vet visit, vaccination, boarding, training or stud.'],['clock','Pick a time','See live free slots or kennel availability.'],['circle-check','We confirm','You get an SMS, plus reminders before vaccines are due.']].forEach(function (s, i) { %>
          <li class="relative rounded-xl bg-white ring-1 ring-stone-200/80 p-4">
            <span class="absolute -top-3 left-4 inline-flex size-6 items-center justify-center rounded-full bg-brand-700 text-white text-xs font-bold"><%= i + 1 %></span>
            <span class="text-brand-700"><%- icon(s[0], 'size-5') %></span>
            <p class="font-semibold mt-2"><%= s[1] %></p>
            <p class="text-sm text-ink-muted mt-1"><%= s[2] %></p>
          </li>
        <% }) %>
      </ol>
    </div>
  </div>
</section>

<!-- Featured puppies -->
<% if (pets.length) { %>
<section class="section">
  <div class="container-x">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <p class="eyebrow"><%- icon('paw-print', 'size-4') %> Available now</p>
        <h2 class="section-title mt-2">Puppies and pets for sale</h2>
        <p class="section-lead">Vaccinated, dewormed and health checked, with records you can see before you visit.</p>
      </div>
      <a href="/pets" class="btn-outline shrink-0">See all pets <%- icon('arrow-right', 'size-4') %></a>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% pets.forEach(function (l) { %><%- include('../partials/pet-card', { l: l }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Best sellers -->
<% if (products.length) { %>
<section class="section bg-white border-y border-stone-200/70">
  <div class="container-x">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <p class="eyebrow"><%- icon('shopping-bag', 'size-4') %> Shop online</p>
        <h2 class="section-title mt-2">Best sellers</h2>
        <p class="section-lead">Cash on delivery, eSewa or Khalti. Fast delivery inside the valley.</p>
      </div>
      <a href="/shop" class="btn-outline shrink-0">Visit the shop <%- icon('arrow-right', 'size-4') %></a>
    </div>
    <div class="mt-10 grid gap-4 grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      <% products.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Why us -->
<section class="section">
  <div class="container-x grid lg:grid-cols-[1fr_1.3fr] gap-12 items-center">
    <div>
      <p class="eyebrow"><%- icon('award', 'size-4') %> Why families choose us</p>
      <h2 class="section-title mt-2">Trusted pet care at Soaltee Mode</h2>
      <p class="section-lead">Run by <%= business.owner %>, The Everest Kennel brings a pet shop, kennel, veterinary home service and animal shelter together, so your pet is cared for by one team that knows them.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/about" class="btn-outline">Our story</a>
        <a href="/animal-sale-policy" class="btn-ghost"><%- icon('shield-check', 'size-5 text-brand-700') %> Health guarantee</a>
      </div>
    </div>
    <ul class="grid sm:grid-cols-2 gap-4">
      <% [['badge-check','Experienced team','Breeding, boarding and caring for dogs of every size in Kathmandu.'],['map','House calls across the valley','Vet visits and vaccinations at home in Kathmandu, Lalitpur and Bhaktapur.'],['dna','Imported and local breeds','Healthy puppies with vaccination, deworming and registration records.'],['shield-check','Health guarantee','Every puppy is checked at handover, backed by our written policy.']].forEach(function (w) { %>
        <li class="card p-5">
          <span class="icon-tile-sm"><%- icon(w[0], 'size-5') %></span>
          <p class="font-bold mt-3"><%= w[1] %></p>
          <p class="text-sm text-ink-muted mt-1"><%= w[2] %></p>
        </li>
      <% }) %>
    </ul>
  </div>
</section>

<!-- Testimonials -->
<% if (testimonials.length) { %>
<section class="section pt-0">
  <div class="container-x">
    <div class="text-center max-w-2xl mx-auto">
      <p class="eyebrow justify-center"><%- icon('heart', 'size-4') %> Happy pet parents</p>
      <h2 class="section-title mt-2">What our customers say</h2>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      <% testimonials.slice(0, 3).forEach(function (t) { %>
        <figure class="card p-6 flex flex-col">
          <div class="flex gap-0.5" role="img" aria-label="<%= t.rating %> out of 5 stars">
            <% for (let s = 1; s <= 5; s++) { %><%- icon('star', 'size-4 ' + (s <= t.rating ? 'text-accent-500 fill-accent-500' : 'text-stone-300')) %><% } %>
          </div>
          <blockquote class="mt-4 text-ink leading-relaxed flex-1">“<%= t.content %>”</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            <span class="inline-flex size-10 items-center justify-center rounded-full bg-brand-100 text-brand-800 font-bold"><%= t.name.charAt(0) %></span>
            <span class="font-semibold text-sm"><%= t.name %></span>
          </figcaption>
        </figure>
      <% }) %>
    </div>
    <% if (settings.business.googleReviewUrl) { %>
      <p class="mt-8 text-center"><a class="link inline-flex items-center gap-1" href="<%= settings.business.googleReviewUrl %>" target="_blank" rel="noopener">Read our reviews on Google <%- icon('arrow-up-right', 'size-4') %></a></p>
    <% } %>
  </div>
</section>
<% } %>

<!-- Shelter CTA -->
<section class="pb-16">
  <div class="container-x">
    <div class="rounded-3xl bg-gradient-to-br from-accent-50 via-white to-brand-50 ring-1 ring-accent-100 p-8 sm:p-12 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center shadow-soft">
      <div>
        <p class="eyebrow text-accent-700"><%- icon('hand-heart', 'size-4') %> Animal Care Shelter</p>
        <h2 class="section-title mt-2">Adopt a friend, or help one in need</h2>
        <p class="text-ink-muted mt-3 max-w-xl">Our shelter rescues injured and stray animals around Kathmandu. <strong class="text-ink"><%= stats.inCare %></strong> animals are in our care right now and <strong class="text-ink"><%= stats.adopted %></strong> have found homes.</p>
      </div>
      <div class="flex flex-col sm:flex-row md:flex-col gap-3">
        <a href="/shelter/adopt" class="btn-primary"><%- icon('heart-handshake', 'size-5') %> Adopt a pet</a>
        <a href="/shelter/report-animal" class="btn-outline"><%- icon('siren', 'size-5 text-accent-700') %> Report an injured animal</a>
      </div>
    </div>
  </div>
</section>

<!-- Blog -->
<% if (posts.length) { %>
<section class="pb-16">
  <div class="container-x">
    <div class="flex items-end justify-between">
      <h2 class="section-title">Pet care tips</h2>
      <a href="/blog" class="link text-sm inline-flex items-center gap-1">All articles <%- icon('arrow-right', 'size-4') %></a>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      <% posts.forEach(function (post) { %>
        <article class="card card-hover overflow-hidden group">
          <a href="/blog/<%= post.slug %>" class="block aspect-[16/9] bg-brand-50 overflow-hidden">
            <img src="<%= imgSrc(post.coverPath, 800) %>" alt="" width="800" height="450" loading="lazy" class="w-full h-full object-cover transition duration-300 group-hover:scale-[1.03]">
          </a>
          <div class="p-5">
            <h3 class="font-bold leading-snug"><a href="/blog/<%= post.slug %>" class="hover:text-brand-700"><%= post.title %></a></h3>
            <% if (post.excerpt) { %><p class="text-sm text-ink-muted mt-2 line-clamp-3"><%= post.excerpt %></p><% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Visit / map -->
<section class="pb-4">
  <div class="container-x grid lg:grid-cols-2 gap-6">
    <div class="card p-6 sm:p-8">
      <p class="eyebrow"><%- icon('store', 'size-4') %> Visit us</p>
      <h2 class="section-title mt-2">The Everest Kennel</h2>
      <p class="mt-3 text-ink-muted flex items-start gap-2"><%- icon('map-pin', 'size-5 text-brand-700 mt-0.5') %> <%= business.address %></p>
      <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
        <% hours.forEach(function (h) { %><dt class="text-ink-muted <%= h.weekday === todayWeekday ? 'font-semibold text-brand-800' : '' %>"><%= weekdays[h.weekday] %></dt><dd class="font-medium tabular-nums <%= h.weekday === todayWeekday ? 'text-brand-800' : '' %>"><%= h.isClosed ? 'Closed' : h.opensAt + ' – ' + h.closesAt %></dd><% }) %>
      </dl>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="<%= telLink() %>" class="btn-primary"><%- icon('phone', 'size-5') %> Call <%= business.landlineDisplay %></a>
        <a href="https://www.google.com/maps/dir/?api=1&destination=<%= settings.business.geoLat %>,<%= settings.business.geoLng %>" class="btn-outline" target="_blank" rel="noopener"><%- icon('navigation', 'size-5') %> Get directions</a>
      </div>
    </div>
    <div class="card overflow-hidden min-h-[300px] relative bg-brand-50">
      <button type="button" class="absolute inset-0 w-full h-full flex flex-col items-center justify-center gap-3 text-brand-800 hover:bg-brand-100/60 transition" data-map-src="<%= settings.business.mapEmbedUrl %>">
        <span class="icon-tile size-14 bg-white"><%- icon('map', 'size-7') %></span>
        <span class="font-semibold">Show map</span>
        <span class="text-xs text-ink-muted">Loads Google Maps</span>
      </button>
    </div>
  </div>
</section>
