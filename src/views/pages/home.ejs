<%
  const icons = {
    home: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
    syringe: '<path d="m18 2 4 4"/><path d="m17 7 3-3"/><path d="M19 9 8.7 19.3a2.4 2.4 0 0 1-3.4 0l-.6-.6a2.4 2.4 0 0 1 0-3.4L15 5"/><path d="m9 11 4 4"/><path d="m5 19-3 3"/>',
    stethoscope: '<path d="M5 3v6a5 5 0 0 0 10 0V3"/><path d="M10 14v2a5 5 0 0 0 10 0v-1"/><circle cx="20" cy="13" r="2"/>',
    kennel: '<path d="M3 21V10l9-7 9 7v11"/><path d="M9 21v-5a3 3 0 0 1 6 0v5"/>',
    whistle: '<circle cx="8" cy="15" r="5"/><path d="M12 12h9v4h-5"/><path d="M8 15h.01"/>',
    heart: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8Z"/>',
    paw: '<circle cx="5" cy="10" r="2"/><circle cx="9" cy="6" r="2"/><circle cx="15" cy="6" r="2"/><circle cx="19" cy="10" r="2"/><path d="M12 12c-3 0-6 4-6 6.5S8 21 12 21s6-.5 6-2.5S15 12 12 12Z"/>',
    shelter: '<path d="M2 12 12 3l10 9"/><path d="M12 21s-6-3.5-6-8a3 3 0 0 1 6-1 3 3 0 0 1 6 1c0 4.5-6 8-6 8Z"/>',
  };
%>
<!-- Hero -->
<section class="relative overflow-hidden bg-gradient-to-br from-brand-900 via-brand-800 to-brand-600 text-white">
  <svg class="absolute inset-x-0 bottom-0 w-full h-40 text-brand-700/40" viewBox="0 0 1200 160" preserveAspectRatio="none" aria-hidden="true"><path d="M0 160 260 40l120 70 150-90 220 110 140-60 310 90v0Z" fill="currentColor"/></svg>
  <div class="container-x relative py-14 sm:py-20 lg:py-24 grid lg:grid-cols-[1.2fr_1fr] gap-10 items-center">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-sm text-brand-100 mb-5">📍 Soaltee Mode, Kathmandu · Since day one, for every paw</p>
      <h1 class="text-3xl sm:text-5xl font-extrabold leading-tight text-white"><%= settings.home.heroTitle %></h1>
      <p class="mt-5 text-lg text-brand-100 max-w-xl"><%= settings.home.heroSubtitle %></p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="<%= telLink() %>" class="btn-accent">📞 Call <%= business.landlineDisplay %></a>
        <a href="<%= whatsappLink('Hello The Everest Kennel, I would like to know more.') %>" class="btn-wa" target="_blank" rel="noopener">💬 WhatsApp</a>
        <a href="/book" class="btn bg-white text-brand-800 hover:bg-brand-50">📅 Book a service</a>
      </div>
      <% if (settings.business.googleReviewCount > 0) { %>
        <p class="mt-6 text-sm text-brand-100">★ <strong class="text-white"><%= settings.business.googleRating.toFixed(1) %></strong> on Google from <%= settings.business.googleReviewCount %> reviews</p>
      <% } %>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:gap-4">
      <% [['/pets','🐶','Puppies for sale','Local & imported'],['/shop/category/dog-food','🥣','Dog & cat food','Delivered to your door'],['/services/house-call-vet','🩺','Vet house call','Anywhere in the valley'],['/services/dog-boarding-kathmandu','🏠','Dog boarding','Safe, clean kennels']].forEach(function (t) { %>
        <a href="<%= t[0] %>" class="rounded-2xl bg-white/10 hover:bg-white/20 backdrop-blur p-4 sm:p-5 transition">
          <span class="text-3xl" aria-hidden="true"><%= t[1] %></span>
          <span class="block mt-2 font-bold"><%= t[2] %></span>
          <span class="block text-sm text-brand-100"><%= t[3] %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Services -->
<section class="section">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow">What we do</p>
      <h2 class="section-title mt-1">Everything your pet needs, in one place</h2>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <% serviceCards.forEach(function (c) { %>
        <a href="<%= c.href %>" class="card p-5 hover:shadow-md hover:border-brand-300 transition group">
          <span class="inline-flex w-12 h-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700 group-hover:bg-brand-700 group-hover:text-white transition">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- icons[c.icon] %></svg>
          </span>
          <h3 class="font-bold mt-4"><%= c.title %></h3>
          <p class="text-sm text-stone-600 mt-1"><%= c.text %></p>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- Featured puppies -->
<% if (pets.length) { %>
<section class="section bg-white border-y border-stone-200">
  <div class="container-x">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Available now</p>
        <h2 class="section-title mt-1">Puppies and pets for sale</h2>
        <p class="text-stone-600 mt-2">Vaccinated, dewormed and health checked, with records you can see.</p>
      </div>
      <a href="/pets" class="btn-outline hidden sm:inline-flex">See all pets</a>
    </div>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% pets.forEach(function (l) { %><%- include('../partials/pet-card', { l: l }) %><% }) %>
    </div>
    <a href="/pets" class="btn-outline mt-6 w-full sm:hidden">See all pets</a>
  </div>
</section>
<% } %>

<!-- Best sellers -->
<% if (products.length) { %>
<section class="section">
  <div class="container-x">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Shop online</p>
        <h2 class="section-title mt-1">Best sellers</h2>
        <p class="text-stone-600 mt-2">Cash on delivery, eSewa or Khalti. Fast delivery inside the valley.</p>
      </div>
      <a href="/shop" class="btn-outline hidden sm:inline-flex">Visit the shop</a>
    </div>
    <div class="mt-8 grid gap-4 grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
      <% products.forEach(function (p) { %><%- include('../partials/product-card', { p: p }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Why us -->
<section class="section bg-brand-50">
  <div class="container-x grid lg:grid-cols-2 gap-10 items-center">
    <div>
      <p class="eyebrow">Why families choose us</p>
      <h2 class="section-title mt-1">Trusted pet care at Soaltee Mode</h2>
      <p class="text-stone-600 mt-3">Run by <%= business.owner %>, The Everest Kennel combines a pet shop, kennel, veterinary home service and an animal care shelter, so your pet is looked after by one team that knows them.</p>
    </div>
    <ul class="grid sm:grid-cols-2 gap-4">
      <% [['Years of experience','Breeding, boarding and caring for dogs of every size in Kathmandu.'],['House calls across the valley','Vet visits and vaccinations at home in Kathmandu, Lalitpur and Bhaktapur.'],['Imported and local breeds','Healthy puppies with vaccination, deworming and registration records.'],['Health guarantee','Every puppy is checked at handover. See our animal sale policy.']].forEach(function (w) { %>
        <li class="card p-5">
          <p class="font-bold text-brand-800">✓ <%= w[0] %></p>
          <p class="text-sm text-stone-600 mt-1"><%= w[1] %></p>
        </li>
      <% }) %>
    </ul>
  </div>
</section>

<!-- Testimonials -->
<% if (testimonials.length) { %>
<section class="section">
  <div class="container-x">
    <p class="eyebrow">Happy pet parents</p>
    <h2 class="section-title mt-1">What our customers say</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      <% testimonials.slice(0, 3).forEach(function (t) { %>
        <figure class="card p-6 flex flex-col">
          <p class="text-accent-500" aria-label="<%= t.rating %> out of 5 stars"><%= '★'.repeat(t.rating) %><span class="text-stone-300"><%= '★'.repeat(5 - t.rating) %></span></p>
          <blockquote class="mt-3 text-stone-700 flex-1">“<%= t.content %>”</blockquote>
          <figcaption class="mt-4 font-semibold">— <%= t.name %></figcaption>
        </figure>
      <% }) %>
    </div>
    <% if (settings.business.googleReviewUrl) { %>
      <p class="mt-6 text-center"><a class="link" href="<%= settings.business.googleReviewUrl %>" target="_blank" rel="noopener">Read our reviews on Google →</a></p>
    <% } %>
  </div>
</section>
<% } %>

<!-- Shelter CTA -->
<section class="section pt-0">
  <div class="container-x">
    <div class="rounded-3xl bg-gradient-to-r from-amber-100 to-amber-50 border border-amber-200 p-8 sm:p-12 grid md:grid-cols-[1.4fr_1fr] gap-8 items-center">
      <div>
        <p class="eyebrow text-amber-800">Animal Care Shelter</p>
        <h2 class="section-title mt-1">Adopt a friend, or help one in need</h2>
        <p class="text-stone-700 mt-3">Our shelter rescues injured and stray animals around Kathmandu. <strong><%= stats.inCare %></strong> animals are in our care right now and <strong><%= stats.adopted %></strong> have found homes.</p>
      </div>
      <div class="flex flex-col sm:flex-row md:flex-col gap-3">
        <a href="/shelter/adopt" class="btn-primary">🐾 Adopt a pet</a>
        <a href="/shelter/report-animal" class="btn-outline">🚑 Report an injured animal</a>
      </div>
    </div>
  </div>
</section>

<!-- Blog -->
<% if (posts.length) { %>
<section class="section pt-0">
  <div class="container-x">
    <div class="flex items-end justify-between">
      <h2 class="section-title">Pet care tips</h2>
      <a href="/blog" class="link text-sm">All articles →</a>
    </div>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      <% posts.forEach(function (post) { %>
        <article class="card overflow-hidden">
          <a href="/blog/<%= post.slug %>" class="block aspect-[16/9] bg-brand-50">
            <img src="<%= imgSrc(post.coverPath, 800) %>" alt="" width="800" height="450" loading="lazy" class="w-full h-full object-cover">
          </a>
          <div class="p-5">
            <h3 class="font-bold leading-snug"><a href="/blog/<%= post.slug %>" class="hover:text-brand-700"><%= post.title %></a></h3>
            <% if (post.excerpt) { %><p class="text-sm text-stone-600 mt-2 line-clamp-3"><%= post.excerpt %></p><% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- Visit / map -->
<section class="section pt-0">
  <div class="container-x grid lg:grid-cols-2 gap-6">
    <div class="card p-6 sm:p-8">
      <h2 class="section-title">Visit The Everest Kennel</h2>
      <p class="mt-3 text-stone-700"><%= business.address %></p>
      <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-6 gap-y-1.5 text-sm">
        <% hours.forEach(function (h) { %><dt class="text-stone-500"><%= weekdays[h.weekday] %></dt><dd class="font-medium"><%= h.isClosed ? 'Closed' : h.opensAt + ' – ' + h.closesAt %></dd><% }) %>
      </dl>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="<%= telLink() %>" class="btn-primary">Call <%= business.landlineDisplay %></a>
        <a href="https://www.google.com/maps/dir/?api=1&destination=<%= settings.business.geoLat %>,<%= settings.business.geoLng %>" class="btn-outline" target="_blank" rel="noopener">Get directions</a>
      </div>
    </div>
    <div class="card overflow-hidden min-h-[280px] relative bg-brand-50">
      <button type="button" class="absolute inset-0 w-full h-full flex flex-col items-center justify-center gap-2 text-brand-800 hover:bg-brand-100 transition" data-map-src="<%= settings.business.mapEmbedUrl %>">
        <span class="text-4xl" aria-hidden="true">🗺️</span>
        <span class="font-semibold">Show map</span>
        <span class="text-xs text-stone-500">Loads Google Maps</span>
      </button>
    </div>
  </div>
</section>
