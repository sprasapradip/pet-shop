<form method="get" class="flex gap-2 items-end mb-4">
  <div><label class="label" for="ae">Entity</label><select id="ae" name="entity" class="input h-10 w-48"><option value="">All</option><% entities.forEach(function (e) { %><option <%= filters.entity === e ? 'selected' : '' %>><%= e %></option><% }) %></select></div>
  <button class="btn-outline btn-sm h-10">Filter</button>
</form>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>IP</th><th>Change</th></tr></thead>
    <tbody>
      <% if (!logs.length) { %><tr><td colspan="6" class="text-center text-stone-500 py-8">No entries.</td></tr><% } %>
      <% logs.forEach(function (l) { %>
        <tr>
          <td class="whitespace-nowrap"><%= formatDateTime(l.createdAt) %></td>
          <td><%= l.user ? l.user.name : '—' %></td>
          <td><%= l.action %></td>
          <td><%= l.entity %><%= l.entityId ? ' #' + l.entityId : '' %></td>
          <td class="text-xs"><%= l.ip || '' %></td>
          <td class="text-xs max-w-md">
            <details><summary class="cursor-pointer link">Show</summary>
              <div class="grid md:grid-cols-2 gap-2 mt-2">
                <pre class="bg-stone-50 rounded p-2 overflow-auto max-h-60 whitespace-pre-wrap break-all">before: <%= JSON.stringify(l.before, null, 1) %></pre>
                <pre class="bg-stone-50 rounded p-2 overflow-auto max-h-60 whitespace-pre-wrap break-all">after: <%= JSON.stringify(l.after, null, 1) %></pre>
              </div>
            </details>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/pagination') %>
