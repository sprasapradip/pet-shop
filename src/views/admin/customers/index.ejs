<form method="get" class="flex gap-2 items-end mb-4">
  <div><label class="label" for="cq">Search</label><input id="cq" name="q" value="<%= q %>" class="input h-10 w-72" placeholder="Name, phone or email"></div>
  <button class="btn-outline btn-sm h-10">Search</button>
</form>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th class="text-right">Orders</th><th class="text-right">Bookings</th><th class="text-right">Pets</th><th>Joined</th></tr></thead>
    <tbody>
      <% if (!customers.length) { %><tr><td colspan="7" class="text-center text-stone-500 py-8">No customers.</td></tr><% } %>
      <% customers.forEach(function (c) { %>
        <tr><td><a class="link font-medium" href="/admin/customers/<%= c.id %>"><%= c.name %></a><%= c.isActive ? '' : ' (inactive)' %></td><td><%= c.phone %></td><td><%= c.email || '' %></td><td class="text-right"><%= c._count.orders %></td><td class="text-right"><%= c._count.bookings %></td><td class="text-right"><%= c._count.pets %></td><td><%= formatDate(c.createdAt) %></td></tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../../partials/pagination') %>
