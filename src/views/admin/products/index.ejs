<div class="flex flex-wrap gap-3 justify-between items-end mb-4">
  <form method="get" class="flex flex-wrap gap-2 items-end">
    <div><label class="label" for="pq">Search</label><input id="pq" name="q" value="<%= filters.q %>" class="input h-10 w-56" placeholder="Name or SKU"></div>
    <div><label class="label" for="pc">Category</label><select id="pc" name="category" class="input h-10 w-48"><option value="">All</option><% categories.forEach(function (c) { %><option value="<%= c.id %>" <%= filters.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %></select></div>
    <label class="flex items-center gap-2 text-sm h-10"><input type="checkbox" name="low" value="1" class="checkbox" <%= filters.low ? 'checked' : '' %>> Low stock</label>
    <button class="btn-outline btn-sm h-10">Filter</button>
  </form>
  <div class="flex flex-wrap gap-2">
    <a href="/admin/products/export.csv" class="btn-outline btn-sm">Export CSV</a>
    <details class="relative">
      <summary class="btn-outline btn-sm list-none cursor-pointer">Import CSV</summary>
      <form action="/admin/products/import" method="post" enctype="multipart/form-data" class="absolute right-0 z-10 mt-2 card p-4 w-80 space-y-3">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <p class="text-xs text-stone-600">Same columns as the export. Products are matched by <code>product_slug</code>, variants by <code>sku</code>.</p>
        <input type="file" name="file" accept=".csv,text/csv" class="file-input" required>
        <button class="btn-primary btn-sm w-full">Import</button>
      </form>
    </details>
    <a href="/admin/products/new" class="btn-primary btn-sm">+ New product</a>
  </div>
</div>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th></th><th>Product</th><th>Category</th><th>Variants</th><th class="text-right">Price</th><th class="text-right">Stock</th><th>Status</th></tr></thead>
    <tbody>
      <% if (!products.length) { %><tr><td colspan="7" class="text-center text-stone-500 py-8">No products found.</td></tr><% } %>
      <% products.forEach(function (p) { const stock = p.variants.reduce(function (s, v) { return s + v.stock; }, 0); const low = p.variants.some(function (v) { return v.stock <= v.lowStockAlert; }); %>
        <tr>
          <td class="w-14"><img src="<%= imgSrc(p.images[0] && p.images[0].path, 400) %>" alt="" width="40" height="40" class="w-10 h-10 rounded-lg object-cover bg-stone-100"></td>
          <td><a class="font-medium link" href="/admin/products/<%= p.id %>/edit"><%= p.name %></a><% if (p.brand) { %><span class="block text-xs text-stone-500"><%= p.brand.name %></span><% } %></td>
          <td><%= p.category.name %></td>
          <td class="text-xs"><%= p.variants.map(function (v) { return v.label; }).join(', ') %></td>
          <td class="text-right whitespace-nowrap"><%= p.variants[0] ? formatNpr(p.variants[0].pricePaisa) : '—' %></td>
          <td class="text-right <%= low ? 'text-amber-700 font-semibold' : '' %>"><%= stock %></td>
          <td><%= p.isActive ? (p.isFeatured ? '★ Featured' : 'Active') : 'Hidden' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../../partials/pagination') %>
