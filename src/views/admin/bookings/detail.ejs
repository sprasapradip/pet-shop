<% const b = booking; const isBoarding = b.service.type === 'BOARDING'; %>
<a href="/admin/bookings" class="back-link"><%- icon('chevron-left', 'size-4') %>All bookings</a>
<div class="grid lg:grid-cols-[1fr_360px] gap-6 items-start mt-4">
  <div class="space-y-6">
    <section class="card p-5">
      <div class="flex justify-between items-start gap-3">
        <div><h2 class="text-xl font-bold"><%= b.service.name %></h2><p class="text-sm text-stone-500 font-mono"><%= b.reference %></p></div>
        <span class="status status-<%= b.status %>"><%= bookingStatusLabel(b.status) %></span>
      </div>
      <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
        <dt class="text-stone-500"><%= isBoarding ? 'Check in' : 'When' %></dt><dd><%= formatDateTime(b.startAt) %></dd>
        <dt class="text-stone-500"><%= isBoarding ? 'Check out' : 'Ends' %></dt><dd><%= formatDateTime(b.endAt) %></dd>
        <% if (b.kennelUnit) { %><dt class="text-stone-500">Kennel</dt><dd><%= b.kennelUnit.code %> (<%= b.kennelUnit.size %>)</dd><% } %>
        <dt class="text-stone-500">Customer</dt><dd><%= b.contactName %> · <a class="link" href="tel:<%= b.contactPhone %>"><%= b.contactPhone %></a> · <a class="link" href="https://wa.me/977<%= b.contactPhone %>" target="_blank" rel="noopener">WhatsApp</a><% if (b.user) { %> · <a class="link" href="/admin/customers/<%= b.user.id %>">account</a><% } %></dd>
        <dt class="text-stone-500">Pet</dt><dd><% if (b.pet) { %><a class="link" href="/admin/medical/pets/<%= b.pet.id %>?booking=<%= b.id %>"><%= b.pet.name %></a> (<%= b.pet.breed ? b.pet.breed.name : speciesLabel(b.pet.species) %>)<% } else { %><%= b.petSummary %><% } %></dd>
        <% if (b.addressText) { %><dt class="text-stone-500">Address</dt><dd><%= b.addressText %><% if (b.latitude) { %> · <a class="link" href="https://www.google.com/maps?q=<%= b.latitude %>,<%= b.longitude %>" target="_blank" rel="noopener">Map pin</a><% } %></dd><% } %>
        <% if (b.notes) { %><dt class="text-stone-500">Customer notes</dt><dd class="whitespace-pre-line"><%= b.notes %></dd><% } %>
        <dt class="text-stone-500">Price</dt><dd><%= b.pricePaisa !== null ? formatNpr(b.pricePaisa) : '—' %></dd>
        <dt class="text-stone-500">Advance / paid</dt><dd><%= formatNpr(b.advancePaisa) %> / <%= formatNpr(b.paidPaisa) %></dd>
        <dt class="text-stone-500">Created</dt><dd><%= formatDateTime(b.createdAt) %></dd>
      </dl>
      <% if (payments.length) { %>
        <ul class="mt-4 text-xs text-stone-600 space-y-1"><% payments.forEach(function (p) { %><li><%= formatDateTime(p.createdAt) %> · <%= p.gateway %> · <%= formatNpr(p.amountPaisa) %> · <span class="status status-<%= p.status %>"><%= p.status %></span></li><% }) %></ul>
      <% } %>
    </section>

    <% if (isBoarding) { %>
      <section class="card p-5" id="care">
        <div class="flex justify-between items-center">
          <h3 class="font-bold">Daily care log</h3>
          <% if (role !== 'VET') { %>
          <form action="/admin/boarding/<%= b.id %>/check" method="post" class="flex gap-2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="booking">
            <% if (['PENDING','CONFIRMED'].includes(b.status)) { %><button name="action" value="in" class="btn-primary btn-sm">Check in</button><% } %>
            <% if (b.status === 'IN_PROGRESS') { %><button name="action" value="out" class="btn-primary btn-sm">Check out</button><% } %>
          </form>
          <% } %>
        </div>
        <ul class="mt-3 space-y-2 text-sm">
          <% b.careLogs.forEach(function (l) { %>
            <li class="flex gap-3 items-start"><strong class="w-28 shrink-0"><%= formatDay(l.logDate) %></strong><span class="flex flex-wrap items-center gap-2"><% if (l.fed) { %><span class="chip-ok"><%- icon('utensils', 'size-3.5') %> Fed</span><% } %><% if (l.walked) { %><span class="chip-ok"><%- icon('footprints', 'size-3.5') %> Walked</span><% } %><% if (l.medsGiven) { %><span class="chip-ok"><%- icon('pill', 'size-3.5') %> Meds</span><% } %><%= l.notes || '' %></span><% if (l.photoPath) { %><img src="<%= imgSrc(l.photoPath, 400) %>" alt="" width="48" height="48" class="w-12 h-12 rounded object-cover"><% } %></li>
          <% }) %>
        </ul>
        <% if (role !== 'VET') { %>
        <form action="/admin/boarding/<%= b.id %>/log" method="post" enctype="multipart/form-data" class="mt-4 border-t border-stone-100 pt-4 grid sm:grid-cols-2 gap-3 items-end">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div><label class="label" for="ld">Date</label><input id="ld" type="date" name="logDate" value="<%= isoDay(new Date()) %>" class="input h-10" required></div>
          <div class="flex gap-4 text-sm h-10 items-center">
            <label class="flex items-center gap-1"><input type="checkbox" name="fed" class="checkbox"> Fed</label>
            <label class="flex items-center gap-1"><input type="checkbox" name="walked" class="checkbox"> Walked</label>
            <label class="flex items-center gap-1"><input type="checkbox" name="medsGiven" class="checkbox"> Meds</label>
          </div>
          <div class="sm:col-span-2"><label class="label" for="ln">Notes</label><input id="ln" name="notes" class="input h-10"></div>
          <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" class="file-input">
          <button class="btn-outline btn-sm h-10">Save log</button>
        </form>
        <% } %>
      </section>
    <% } %>
  </div>

  <form action="/admin/bookings/<%= b.id %>" method="post" class="card p-5">
    <h3 class="font-bold mb-3">Manage</h3>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../../partials/field', { name: 'status', label: 'Status', type: 'select', value: b.status, options: statuses.map(function (s) { return [s, bookingStatusLabel(s)]; }) }) %>
    <% if (role !== 'VET') { %>
      <%- include('../../partials/field', { name: 'assignedToId', label: 'Assigned to', type: 'select', value: b.assignedToId || '', options: [['','Unassigned']].concat(staff.map(function (s) { return [s.id, s.name + ' (' + s.role.toLowerCase() + ')']; })) }) %>
    <% } else { %><input type="hidden" name="assignedToId" value="<%= b.assignedToId || '' %>"><% } %>
    <div class="grid grid-cols-2 gap-3">
      <%- include('../../partials/field', { name: 'pricePaisa', label: 'Price (Rs)', type: 'number', value: b.pricePaisa !== null ? b.pricePaisa / 100 : '', attrs: 'min="0" step="1"' }) %>
      <%- include('../../partials/field', { name: 'paidRupees', label: 'Paid (Rs)', type: 'number', value: b.paidPaisa / 100, attrs: 'min="0" step="1"' }) %>
    </div>
    <%- include('../../partials/field', { name: 'staffNotes', label: 'Staff notes', type: 'textarea', rows: 4, value: b.staffNotes || '' }) %>
    <label class="flex items-center gap-2 text-sm mb-4"><input type="checkbox" name="notify" class="checkbox" checked> SMS customer on confirm / cancel</label>
    <button class="btn-primary w-full">Save</button>
    <% if (b.pet) { %><a href="/admin/medical/pets/<%= b.pet.id %>?booking=<%= b.id %>" class="btn-outline w-full mt-2">Add vaccination / medical record</a><% } %>
  </form>
</div>
