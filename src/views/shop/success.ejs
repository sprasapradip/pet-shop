<section class="container-x py-12 max-w-2xl">
  <div class="card p-8 text-center">
    <span class="inline-flex size-16 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 ring-1 ring-brand-100"><%- icon('party-popper', 'size-8') %></span>
    <h1 class="text-2xl sm:text-3xl font-extrabold mt-3">Thank you, <%= order.customerName.split(' ')[0] %>!</h1>
    <p class="text-stone-600 mt-2">Your order <strong><%= order.orderNo %></strong> has been received<%= order.status === 'PENDING_PAYMENT' ? ' and is waiting for payment confirmation' : '' %>. We will call <%= order.customerPhone %> to confirm delivery.</p>
    <p class="mt-3"><span class="status status-<%= order.status %>"><%= orderStatusLabel(order.status) %></span></p>
  </div>
  <div class="card p-6 mt-6">
    <h2 class="font-bold">Order details</h2>
    <ul class="mt-3 divide-y divide-stone-100 text-sm">
      <% order.items.forEach(function (i) { %><li class="py-2 flex justify-between gap-3"><span><%= i.name %> × <%= i.quantity %></span><span><%= formatNpr(i.totalPaisa) %></span></li><% }) %>
    </ul>
    <dl class="mt-3 pt-3 border-t border-stone-200 text-sm space-y-1">
      <div class="flex justify-between"><dt>Delivery</dt><dd><%= order.deliveryPaisa ? formatNpr(order.deliveryPaisa) : 'Free' %></dd></div>
      <div class="flex justify-between font-bold text-base"><dt>Total</dt><dd><%= formatNpr(order.totalPaisa) %></dd></div>
      <div class="flex justify-between"><dt>Payment</dt><dd><%= order.paymentMethod === 'COD' ? 'Cash on delivery' : order.paymentMethod %></dd></div>
    </dl>
    <p class="text-sm text-stone-600 mt-4"><strong>Deliver to:</strong> <%= order.shippingAddress %></p>
  </div>
  <div class="mt-6 flex flex-wrap gap-3 justify-center">
    <% if (user) { %><a href="/account/orders/<%= order.orderNo %>" class="btn-primary">Track order</a><% } %>
    <a href="/shop" class="btn-outline">Continue shopping</a>
  </div>
</section>
