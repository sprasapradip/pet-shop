<footer class="hero-bg text-brand-100 mt-20">
  <div class="container-x py-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.3fr]">
    <div>
      <a href="/" class="flex items-center gap-2.5 text-white font-extrabold text-lg">
        <img src="/assets/img/logo.svg" alt="" width="40" height="40"> <%= business.name %>
      </a>
      <p class="text-sm leading-relaxed text-brand-100/80 mt-4 max-w-xs"><%= business.tagline %>. Pet shop, kennel, veterinary home service and animal care shelter at Soaltee Mode.</p>
      <ul class="mt-5 space-y-2 text-sm text-brand-100/85">
        <li class="flex items-center gap-2"><%- icon('shield-check', 'size-4 text-brand-300') %> Registered veterinarian</li>
        <li class="flex items-center gap-2"><%- icon('truck', 'size-4 text-brand-300') %> Delivery across Nepal</li>
        <li class="flex items-center gap-2"><%- icon('wallet', 'size-4 text-brand-300') %> Cash on delivery, eSewa, Khalti</li>
      </ul>
      <% if (settings.business.vetName) { %>
        <p class="text-xs mt-4 text-brand-200/80">Veterinarian: <%= settings.business.vetName %><% if (settings.business.vetRegistrationNo) { %> (NVC Reg. No. <%= settings.business.vetRegistrationNo %>)<% } %></p>
      <% } %>
    </div>
    <div>
      <h2 class="footer-h">Shop</h2>
      <ul class="footer-list">
        <li><a href="/shop/category/dog-food">Dog food</a></li>
        <li><a href="/shop/category/cat-food">Cat food</a></li>
        <li><a href="/shop/category/accessories">Accessories</a></li>
        <li><a href="/shop/category/toys">Toys</a></li>
        <li><a href="/shop/category/supplements">Supplements</a></li>
        <li><a href="/pets">Puppies for sale</a></li>
        <li><a href="/sell-your-pet">Sell your pet</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-h">Services</h2>
      <ul class="footer-list">
        <li><a href="/services/house-call-vet">Vet house call</a></li>
        <li><a href="/services/vaccination">Vaccination</a></li>
        <li><a href="/services/dog-boarding-kathmandu">Dog boarding</a></li>
        <li><a href="/services/dog-training">Dog training</a></li>
        <li><a href="/services/mating-stud-service">Stud service</a></li>
        <li><a href="/shelter">Animal shelter</a></li>
      </ul>
    </div>
    <div>
      <h2 class="footer-h">Visit or call</h2>
      <address class="not-italic text-sm space-y-2.5 text-brand-100/85">
        <p class="flex gap-2.5"><%- icon('map-pin', 'size-4 mt-0.5 text-brand-300') %><span><%= business.address %></span></p>
        <p><a class="flex gap-2.5 hover:text-white transition" href="<%= telLink() %>"><%- icon('phone', 'size-4 mt-0.5 text-brand-300') %><%= business.phoneDisplay %></a></p>
        <% if (settings.business.mobile) { %><p><a class="flex gap-2.5 hover:text-white transition" href="<%= telLink(settings.business.mobile) %>"><%- icon('smartphone', 'size-4 mt-0.5 text-brand-300') %><%= settings.business.mobile %></a></p><% } %>
        <p><a class="flex gap-2.5 hover:text-white transition" href="<%= whatsappLink() %>" target="_blank" rel="noopener"><%- icon('whatsapp', 'size-4 mt-0.5 text-brand-300') %>WhatsApp us</a></p>
        <% if (settings.business.email) { %><p><a class="flex gap-2.5 hover:text-white transition" href="mailto:<%= settings.business.email %>"><%- icon('mail', 'size-4 mt-0.5 text-brand-300') %><%= settings.business.email %></a></p><% } %>
      </address>
      <dl class="text-xs mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-brand-100/80 rounded-xl bg-white/5 ring-1 ring-white/10 p-3">
        <% hours.forEach(function (h) { %>
          <dt class="font-medium"><%= weekdays[h.weekday].slice(0, 3) %></dt><dd class="tabular-nums"><%= h.isClosed ? 'Closed' : h.opensAt + ' – ' + h.closesAt %></dd>
        <% }) %>
      </dl>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x py-5 flex flex-col sm:flex-row gap-3 justify-between text-xs text-brand-100/70">
      <p>© <%= new Date().getFullYear() %> <%= business.name %>. All rights reserved.</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label="Legal">
        <a class="hover:text-white" href="/about">About</a><a class="hover:text-white" href="/faq">FAQ</a><a class="hover:text-white" href="/privacy-policy">Privacy</a><a class="hover:text-white" href="/terms">Terms</a><a class="hover:text-white" href="/refund-policy">Refunds</a><a class="hover:text-white" href="/animal-sale-policy">Animal sale policy</a>
        <% (settings.business.socialLinks || []).forEach(function (l) { %><a class="hover:text-white capitalize" href="<%= l %>" rel="noopener" target="_blank"><%= new URL(l).hostname.replace('www.', '').split('.')[0] %></a><% }) %>
      </nav>
    </div>
  </div>
</footer>
