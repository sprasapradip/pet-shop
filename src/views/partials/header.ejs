<% if (settings.home.announcement) { %>
<div class="bg-accent-500 text-stone-900 text-sm text-center px-4 py-2 font-medium"><%= settings.home.announcement %></div>
<% } %>
<div class="bg-brand-900 text-brand-100 text-xs sm:text-sm hidden md:block">
  <div class="container-x flex items-center justify-between py-1.5">
    <span>📍 <%= business.address %></span>
    <span class="flex gap-4">
      <a class="hover:text-white" href="<%= telLink() %>">📞 <%= business.landlineDisplay %></a>
      <a class="hover:text-white" href="<%= whatsappLink() %>" rel="noopener" target="_blank">WhatsApp</a>
    </span>
  </div>
</div>
<header class="bg-white/95 backdrop-blur border-b border-stone-200 sticky top-0 z-30" data-nav>
  <div class="container-x flex items-center justify-between h-16 gap-4">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="<%= business.name %> home">
      <img src="/assets/img/logo.svg" alt="" width="40" height="40">
      <span class="font-extrabold text-brand-800 leading-tight text-lg">The Everest<br class="sm:hidden"> Kennel</span>
    </a>
    <nav class="hidden lg:flex items-center gap-1 text-[15px] font-medium" aria-label="Main">
      <% [['/shop','Shop'],['/pets','Puppies & Pets'],['/services','Services'],['/shelter','Shelter'],['/blog','Blog'],['/contact','Contact']].forEach(function (item) { %>
        <a href="<%= item[0] %>" class="nav-link <%= isActive(item[0]) ? 'nav-link-active' : '' %>" <%= isActive(item[0]) ? 'aria-current=page' : '' %>><%= item[1] %></a>
      <% }) %>
    </nav>
    <div class="flex items-center gap-1 sm:gap-2">
      <form action="/shop" method="get" role="search" class="hidden md:block">
        <label for="hdr-q" class="sr-only">Search products</label>
        <input id="hdr-q" name="q" type="search" placeholder="Search dog food, toys…" class="input h-10 w-48 xl:w-64 text-sm" value="<%= typeof query.q === 'string' && currentPath.startsWith('/shop') ? query.q : '' %>">
      </form>
      <a href="<%= user ? (isStaff ? '/admin' : '/account') : '/login' %>" class="icon-btn" aria-label="<%= user ? 'My account' : 'Log in' %>">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
      </a>
      <a href="/cart" class="icon-btn relative" aria-label="Cart, <%= cartCount %> items">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20" r="1.5"/><circle cx="17" cy="20" r="1.5"/></svg>
        <span data-cart-count class="absolute -top-1 -right-1 min-w-[20px] h-5 px-1 rounded-full bg-accent-500 text-stone-900 text-xs font-bold flex items-center justify-center <%= cartCount ? '' : 'hidden' %>"><%= cartCount %></span>
      </a>
      <a href="/book" class="btn-primary hidden sm:inline-flex h-10">Book now</a>
      <button type="button" class="icon-btn lg:hidden" data-nav-toggle aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="lg:hidden hidden border-t border-stone-200 bg-white" aria-label="Mobile">
    <div class="container-x py-3 grid gap-1">
      <form action="/shop" method="get" role="search" class="mb-2">
        <label for="m-q" class="sr-only">Search products</label>
        <input id="m-q" name="q" type="search" placeholder="Search products" class="input w-full">
      </form>
      <% [['/shop','Shop'],['/pets','Puppies & Pets'],['/services','Services'],['/book','Book a service'],['/shelter','Animal shelter'],['/sell-your-pet','Sell your pet'],['/blog','Blog'],['/about','About us'],['/faq','FAQ'],['/contact','Contact']].forEach(function (item) { %>
        <a href="<%= item[0] %>" class="mobile-link"><%= item[1] %></a>
      <% }) %>
      <% if (user) { %>
        <form action="/logout" method="post" class="mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="mobile-link w-full text-left">Log out</button></form>
      <% } %>
    </div>
  </nav>
</header>
