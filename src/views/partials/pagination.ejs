<% if (meta.pages > 1) { %>
<nav class="flex items-center justify-center gap-2 mt-10" aria-label="Pagination">
  <% if (meta.hasPrev) { %><a class="btn-outline" href="<%= pageLink(meta.page - 1) %>" rel="prev">← Previous</a><% } %>
  <span class="text-sm text-stone-600 px-3">Page <%= meta.page %> of <%= meta.pages %></span>
  <% if (meta.hasNext && meta.page < 50) { %><a class="btn-outline" href="<%= pageLink(meta.page + 1) %>" rel="next">Next →</a><% } %>
</nav>
<% } %>
