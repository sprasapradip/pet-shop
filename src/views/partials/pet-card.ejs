<%
  const img = l.images[0];
  const statusBadge = { AVAILABLE: ['Available', 'bg-brand-700 text-white'], RESERVED: ['Reserved', 'bg-amber-500 text-amber-950'], SOLD: ['Sold', 'bg-stone-800 text-white'] }[l.status];
%>
<article class="card card-hover overflow-hidden flex flex-col group">
  <a href="/pets/<%= l.slug %>" class="relative block aspect-[4/3] bg-stone-100 overflow-hidden">
    <img src="<%= imgSrc(img && img.path, 800) %>" <% if (img) { %>srcset="<%= imgSrcset(img.path) %>" sizes="(max-width: 640px) 100vw, 380px"<% } %> alt="<%= img ? img.alt : l.title %>" width="800" height="600" loading="lazy" class="w-full h-full object-cover transition duration-300 group-hover:scale-[1.04] <%= l.status === 'SOLD' ? 'grayscale' : '' %>">
    <% if (statusBadge) { %><span class="badge absolute top-3 left-3 shadow-soft <%= statusBadge[1] %>"><%= statusBadge[0] %></span><% } %>
    <% if (l.origin === 'IMPORTED') { %><span class="badge absolute top-3 right-3 bg-white/95 text-ink shadow-soft"><%- icon('award', 'size-3.5 text-accent-700') %> Imported</span><% } %>
  </a>
  <div class="p-5 flex flex-col flex-1">
    <h3 class="font-bold text-lg leading-snug"><a href="/pets/<%= l.slug %>" class="hover:text-brand-700"><%= l.title %></a></h3>
    <p class="text-sm text-ink-muted mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
      <span class="inline-flex items-center gap-1"><%- icon(l.species === 'CAT' ? 'cat' : l.species === 'BIRD' ? 'bird' : 'dog', 'size-4') %><%= l.breed.name %></span>
      <span><%= l.gender === 'MALE' ? 'Male' : 'Female' %></span>
      <span class="inline-flex items-center gap-1"><%- icon('calendar-days', 'size-4') %><%= ageFrom(l.dateOfBirth) %></span>
    </p>
    <ul class="flex flex-wrap gap-1.5 mt-3">
      <% if (l.vaccinated) { %><li class="chip-ok"><%- icon('syringe', 'size-3.5') %> Vaccinated</li><% } %>
      <% if (l.dewormed) { %><li class="chip-ok"><%- icon('pill', 'size-3.5') %> Dewormed</li><% } %>
      <% if (l.registrationNo) { %><li class="chip-ok"><%- icon('file-text', 'size-3.5') %> KCI papers</li><% } %>
    </ul>
    <div class="mt-auto pt-4 flex items-center justify-between border-t border-stone-100 mt-4">
      <p class="font-extrabold text-xl text-ink tabular-nums"><%= formatNpr(l.pricePaisa) %></p>
      <span class="text-xs font-medium text-ink-muted tabular-nums">Code <%= l.code %></span>
    </div>
  </div>
</article>
