<section class="container-x py-16 max-w-md text-center">
  <div class="card p-8">
    <span class="inline-flex size-16 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 ring-1 ring-brand-100"><%- icon('lock', 'size-8') %></span>
    <h1 class="text-xl font-bold mt-3">Redirecting to eSewa…</h1>
    <p class="text-stone-600 mt-2">You are paying for <%= label %>. If nothing happens, press the button.</p>
    <form action="<%= start.action %>" method="post" data-autosubmit class="mt-6">
      <% Object.keys(start.fields).forEach(function (k) { %><input type="hidden" name="<%= k %>" value="<%= start.fields[k] %>"><% }) %>
      <button class="btn-primary w-full">Continue to eSewa</button>
    </form>
  </div>
</section>
