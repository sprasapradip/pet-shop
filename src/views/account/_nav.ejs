<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6">
  <div>
    <p class="text-sm text-stone-500">My account</p>
    <h1 class="text-2xl sm:text-3xl font-extrabold">Hello, <%= user.name.split(' ')[0] %></h1>
  </div>
  <form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn-ghost btn-sm">Log out</button></form>
</div>
<nav class="flex gap-1 overflow-x-auto border-b border-stone-200 mb-6 -mx-4 px-4 sm:mx-0 sm:px-0" aria-label="Account">
  <% [['/account','Overview'],['/account/orders','Orders'],['/account/bookings','Bookings'],['/account/pets','My pets'],['/account/profile','Profile']].forEach(function (t) {
    const active = t[0] === '/account' ? currentPath === '/account' || currentPath === '/account/' : currentPath.startsWith(t[0]); %>
    <a href="<%= t[0] %>" class="px-4 py-3 whitespace-nowrap text-sm font-medium border-b-2 <%= active ? 'border-brand-700 text-brand-800' : 'border-transparent text-stone-600 hover:text-brand-700' %>" <%= active ? 'aria-current=page' : '' %>><%= t[1] %></a>
  <% }) %>
</nav>
