<section class="container-x py-8">
  <%- include('_nav') %>
  <div class="grid lg:grid-cols-2 gap-6">
    <form action="/account/profile" method="post" class="card p-6">
      <h2 class="font-bold text-lg mb-4">Profile</h2>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../partials/field', { name: 'name', label: 'Name', required: true, value: oldValue('name', profile.name) }) %>
      <div class="field"><p class="label">Phone</p><p class="text-stone-700"><%= profile.phone %> <% if (profile.phoneVerifiedAt) { %><span class="chip-ok ml-1"><%- icon('badge-check', 'size-3.5') %> Verified</span><% } %></p><p class="hint">To change your phone number, please contact us.</p></div>
      <%- include('../partials/field', { name: 'email', label: 'Email', type: 'email', value: oldValue('email', profile.email || '') }) %>
      <button class="btn-primary">Save profile</button>
    </form>
    <form action="/account/profile/password" method="post" class="card p-6">
      <h2 class="font-bold text-lg mb-4">Change password</h2>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%- include('../partials/field', { name: 'currentPassword', label: 'Current password', type: 'password', required: true, attrs: 'autocomplete="current-password"' }) %>
      <%- include('../partials/field', { name: 'password', label: 'New password', type: 'password', required: true, attrs: 'autocomplete="new-password" minlength="8"' }) %>
      <%- include('../partials/field', { name: 'passwordConfirm', label: 'Confirm new password', type: 'password', required: true, attrs: 'autocomplete="new-password"' }) %>
      <button class="btn-outline">Change password</button>
    </form>
    <div class="card p-6">
      <h2 class="font-bold text-lg mb-3">Saved addresses</h2>
      <% if (!profile.addresses.length) { %><p class="text-sm text-stone-500">Addresses are saved when you check out.</p><% } %>
      <ul class="space-y-3"><% profile.addresses.forEach(function (a) { %>
        <li class="flex justify-between gap-3 text-sm"><span><strong><%= a.label %><%= a.isDefault ? ' (default)' : '' %>:</strong> <%= [a.line1, a.area, a.city, a.district].join(', ') %></span>
          <form action="/account/addresses/<%= a.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-red-700 text-sm hover:underline">Remove</button></form></li>
      <% }) %></ul>
    </div>
    <form action="/account/delete" method="post" class="card p-6 border-red-200" data-confirm="Permanently delete your account? This cannot be undone.">
      <h2 class="font-bold text-lg text-red-800">Delete account</h2>
      <p class="text-sm text-stone-600 mt-1">Removes your pets, addresses and personal details. Order records are kept anonymised for accounting.</p>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="confirm-del" class="label mt-3">Type DELETE to confirm</label>
      <input id="confirm-del" name="confirm" class="input" autocomplete="off">
      <button class="btn-danger mt-3">Delete my account</button>
    </form>
  </div>
</section>
