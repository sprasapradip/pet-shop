{
  "name": "everest-kennel",
  "version": "1.0.0",
  "license": "MIT",
  "author": "sprasapradip <subedipradip199@gmail.com>",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"npm:css:watch\"",
    "dev:worker": "tsx src/worker.ts",
    "build": "npm run css:build && tsc -p tsconfig.json && npm run copy:views",
    "copy:views": "node scripts/copy-views.mjs",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "worker:once": "node dist/worker-once.js",
    "css:build": "tailwindcss -i ./src/styles/app.css -o ./public/assets/css/app.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/app.css -o ./public/assets/css/app.css --watch",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:unit": "vitest run tests/unit --config vitest.unit.config.ts",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^3.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^5.0.1",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "lru-cache": "^11.0.2",
    "multer": "^2.4.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-roll": "^2.1.0",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@playwright/test": "^1.48.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.0",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/express-mysql-session": "^3.0.8",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.16",
    "@types/sanitize-html": "^2.13.0",
    "@types/supertest": "^6.0.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
